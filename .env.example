# Copy to web/.env.local (web vars) and supabase/functions/.env (function vars).
# Never commit real values.

# ── web (public, baked into the static build) ───────────────────────────────
# "supabase" to use Supabase; anything else uses the local dev API (npm run dev:api)
NEXT_PUBLIC_BACKEND=supabase
# From `npx supabase status` locally, or Project Settings → API in production
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL (absolute links in social previews), e.g. https://quarryfind.com
NEXT_PUBLIC_SITE_URL=
# Shown in the API reference, e.g. https://api.yourdomain.com
NEXT_PUBLIC_API_BASE=
# Only for local-mode development
NEXT_PUBLIC_DEV_API=http://localhost:8787

# ── edge functions (secret; `npx supabase secrets set` in production) ─────
# Comma-separated browser origins allowed to call the functions
ALLOWED_ORIGINS=http://localhost:3000
# Random 32+ char string; authenticates search-start → search-batch calls
INTERNAL_SECRET=
# Optional: a fine-grained GitHub token with no scopes raises GitHub API limits from 60/h to 5000/h
GITHUB_TOKEN=
# Optional: Gravatar API key for higher profile lookup limits
GRAVATAR_API_KEY=
# Optional: a Reddit "script" app (reddit.com/prefs/apps) for the official API; Reddit blocks anonymous lookups
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── auth providers (Supabase dashboard → Authentication → Providers) ──────
# Locally: set in supabase/config.toml [auth.external.github] / [auth.external.google] via env()
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── email (Supabase Auth → SMTP settings, production only) ────────────────
RESEND_API_KEY=
